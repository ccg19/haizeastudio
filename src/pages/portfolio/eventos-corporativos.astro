---
// Página no listada: no está en el menú, no sale en Google ni en el sitemap.
// Compártela solo con quien te contacte para un evento corporativo.
import Layout from '../../layouts/Layout.astro';
import PortfolioMarquee from '../../components/PortfolioMarquee.astro';
import { portfolioSectors, portfolioItems } from '../../data/site.js';

const sector = portfolioSectors.find((s) => s.slug === 'eventos-corporativos');
const items = portfolioItems.filter((item) => item.sector === 'eventos-corporativos');
---

<Layout title={`Portfolio — ${sector.label}`} description={sector.intro} noindex>
  <section class="sector-header">
    <div class="container">
      <p class="eyebrow">Portfolio</p>
      <h1 class="headline-editorial"><span class="tone-b">{sector.label}.</span></h1>
      <p class="lede">{sector.intro}</p>
      <p class="value-prop">
        Transformamos un evento puntual en un activo visual de marca que puedes reutilizar
        durante meses para:
      </p>
      <ul class="value-list">
        <li>Posicionamiento de marca</li>
        <li>Comunicación en redes</li>
        <li>Captación de clientes</li>
        <li>Captación de asistentes para próximos eventos</li>
        <li>Sponsors y partners</li>
        <li>Web, dossier y presentaciones</li>
      </ul>
    </div>
  </section>

  {sector.subsections.map((sub, i) => {
    const subItems = items.filter((item) => item.subsection === sub.key);
    return (
      <section class="sector-band">
        <div class="container">
          <h2 class="band-title">{sub.label}</h2>
        </div>
        <PortfolioMarquee items={subItems} reverse={i % 2 === 1} />
      </section>
    );
  })}
</Layout>

<style>
  .sector-header {
    padding-bottom: 1rem;
  }

  .value-prop {
    margin-top: 1.5rem;
    font-weight: 600;
    max-width: 60ch;
  }

  .value-list {
    margin-top: 0.75rem;
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.4rem 2.5rem;
    color: var(--color-charcoal-soft);
  }

  .value-list li {
    list-style: disc;
    margin-left: 1.2rem;
  }

  @media (max-width: 640px) {
    .value-list {
      grid-template-columns: 1fr;
    }
  }

  .sector-band {
    padding-block: 2.5rem;
  }

  .band-title {
    font-family: var(--font-serif-display);
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    margin-bottom: 1.25rem;
  }
</style>
