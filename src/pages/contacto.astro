---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, socialLinks } from '../data/site.js';
---

<Layout
  title="Contacto y presupuesto"
  description="Ponte en contacto con Haizea Studio para tu próximo proyecto de fotografía, vídeo o contenido de marca."
>
  <section class="contact-header">
    <div class="container">
      <p class="eyebrow">Hablemos</p>
      <h1 class="headline-editorial"><span class="tone-b">contacto.</span></h1>
      <p class="lede">
        Cuéntame en qué punto está tu proyecto y qué necesitas.
      </p>
    </div>
  </section>

  <section class="contact-body">
    <div class="container contact-grid">
      <div class="contact-form-col">
        <ContactForm />
      </div>

      <aside class="contact-side">
        <div class="side-card card">
          <h3>Contacto directo</h3>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>

        <div class="side-card card">
          <h3>Perfil en Malt</h3>
          <p>También puedes encontrarme y contratar mis servicios a través de Malt.</p>
          <a href={socialLinks.malt} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Ver perfil en Malt
          </a>
        </div>

      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .side-card {
    padding: 2rem;
  }

  .side-card:hover {
    transform: none;
  }

  .side-card h3 {
    margin-bottom: 0.6rem;
  }

  .side-card a.btn {
    margin-top: 0.75rem;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
