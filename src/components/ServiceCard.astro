---
interface Props {
  title: string;
  description: string;
  bullets?: string[];
  href?: string;
}

const { title, description, bullets = [], href } = Astro.props;
---

<article class="service-card card">
  <h3>{title}</h3>
  <p>{description}</p>
  {bullets.length > 0 && (
    <ul>
      {bullets.map((b) => <li>{b}</li>)}
    </ul>
  )}
  {href && (
    <a href={href} class="service-link">Ver más &rarr;</a>
  )}
</article>

<style>
  .service-card {
    padding: 2.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .service-card h3 {
    color: var(--color-green);
    margin-bottom: 0.5rem;
  }

  .service-card p {
    margin-bottom: 1.25rem;
  }

  .service-card ul {
    margin: 0 0 1.25rem;
    padding-left: 1.1rem;
    color: var(--color-charcoal-soft);
  }

  .service-card li {
    margin-bottom: 0.4rem;
  }

  .service-link {
    margin-top: auto;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-green);
  }

  .service-link:hover {
    text-decoration: underline;
  }
</style>
