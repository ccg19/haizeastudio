---
// Banner de consentimiento de cookies. Mientras no aceptes, Google Analytics
// no carga ningún script ni cookie — cumple con el RGPD/LSSI: consentimiento
// previo, no "consentimiento" por omisión.
import { site } from '../data/site.js';
---

<div id="consent-banner" class="consent-banner" role="dialog" aria-live="polite" aria-label="Aviso de cookies" hidden>
  <div class="consent-inner">
    <p>
      Usamos cookies analíticas para entender cómo se usa la web. Solo se activan si las aceptas.
      Más información en la <a href="/politica-cookies">política de cookies</a>.
    </p>
    <div class="consent-actions">
      <button type="button" id="consent-reject" class="btn btn-secondary">Rechazar</button>
      <button type="button" id="consent-accept" class="btn btn-primary">Aceptar</button>
    </div>
  </div>
</div>

<script define:vars={{ gaId: site.googleAnalyticsId }}>
  const STORAGE_KEY = 'haizea-cookie-consent';

  function loadAnalytics() {
    if (!gaId || gaId.includes('XXXX') || window.__gaLoaded) return;
    window.__gaLoaded = true;
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
    document.head.appendChild(script);
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', gaId, { anonymize_ip: true });
  }

  const banner = document.getElementById('consent-banner');
  const stored = localStorage.getItem(STORAGE_KEY);

  if (stored === 'accepted') {
    loadAnalytics();
  } else if (stored !== 'rejected') {
    banner.hidden = false;
  }

  document.getElementById('consent-accept')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'accepted');
    banner.hidden = true;
    loadAnalytics();
  });

  document.getElementById('consent-reject')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'rejected');
    banner.hidden = true;
  });
</script>

<style>
  .consent-banner {
    position: fixed;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 300;
    background: var(--color-charcoal);
    color: var(--color-cream);
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
    padding: 1.25rem 1.5rem;
  }

  .consent-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .consent-banner p {
    margin: 0;
    color: rgba(245, 243, 238, 0.85);
    font-size: 0.88rem;
    flex: 1;
    min-width: 240px;
  }

  .consent-banner a {
    color: var(--color-cream);
    text-decoration: underline;
  }

  .consent-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .consent-actions .btn {
    padding: 0.6rem 1.2rem;
    font-size: 0.85rem;
  }

  .consent-actions .btn-secondary {
    color: var(--color-cream);
    border-color: rgba(245, 243, 238, 0.35);
  }

  .consent-actions .btn-secondary:hover {
    background: rgba(245, 243, 238, 0.08);
  }

  @media (max-width: 560px) {
    .consent-inner {
      flex-direction: column;
      align-items: stretch;
    }

    .consent-actions {
      justify-content: flex-end;
    }
  }
</style>
