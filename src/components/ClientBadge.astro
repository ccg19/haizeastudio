---
// Insignia de texto para clientes. Cuando tengas permiso/logos oficiales de cada
// marca, puedes sustituir el <span> por un <img> con el logo correspondiente.
interface Props {
  name: string;
  note?: string;
}

const { name, note } = Astro.props;
---

<div class="client-badge card">
  <span class="client-name">{name}</span>
  {note && <span class="client-note">{note}</span>}
</div>

<style>
  .client-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 1.75rem 1rem;
    text-align: center;
  }

  .client-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-charcoal);
  }

  .client-note {
    font-size: 0.75rem;
    color: var(--color-charcoal-soft);
  }
</style>
